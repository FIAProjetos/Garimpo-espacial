# =============================================================================
# Garimpo Espacial - Variaveis de ambiente
# Copie para .env e ajuste os valores:  cp .env.example .env
# NUNCA commite o arquivo .env (esta no .gitignore)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=garimpo
POSTGRES_PASSWORD=troque-esta-senha-agora
POSTGRES_DB=garimpo_db
DB_HOST=db
DB_PORT=5432

# --- Backend (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Connection string (usada pelo dotnet run local; o compose monta automaticamente no Docker)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=garimpo_db;Username=garimpo;Password=troque-esta-senha-agora

# JWT — autenticacao da nossa API (registro + login + Bearer token)
Security__Jwt__Secret=gere-um-secret-com-pelo-menos-32-caracteres-aqui
Security__Jwt__Issuer=GarimpoEspacial
Security__Jwt__Audience=GarimpoEspacialApp
Security__Jwt__ExpirationHours=24

# CORS — origens permitidas do frontend
Security__AllowedOrigins=http://localhost:8081,http://localhost:19000,http://localhost:19001,http://localhost:19002

# --- Fontes de telemetria orbital ---
# Celestrak: catalogo TLE publico, sem autenticacao
ExternalServices__Celestrak__BaseUrl=https://celestrak.org/NORAD/elements/
ExternalServices__Celestrak__DefaultGroup=cosmos-2251-debris

# Space-Track (NORAD oficial): opcional, requer cadastro em https://www.space-track.org
ExternalServices__SpaceTrack__Username=
ExternalServices__SpaceTrack__Password=
ExternalServices__SpaceTrack__BaseUrl=https://www.space-track.org

# --- Frontend (Expo / React Native) ---
EXPO_PUBLIC_API_URL=http://localhost:8080
