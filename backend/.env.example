# Backend isolado — use o .env da raiz do mono-repo.
# Rode: docker compose --env-file ../.env up --build
#
# Variaveis necessarias (ver ../.env.example):
#   POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
#   Security__Jwt__Secret (min. 32 caracteres)
#   ConnectionStrings__DefaultConnection (apenas para dotnet run local)
